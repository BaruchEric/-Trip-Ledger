# Google Maps Platform API key (Maps JS, Places New, Routes, Maps Static)
# Restrict by HTTP referrer and enabled APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Firebase Web configuration overrides (optional in AI Studio; takes precedence over firebase-applet-config.json)
# Restrict the Web API key by HTTP referrer and Firebase APIs in Google Cloud Console.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# Hosted application URL
APP_URL="YOUR_APP_URL"
