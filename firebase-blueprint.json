{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private employee profile and mileage reimbursement preferences for a Curacao employee.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "maxLength": 100 },
        "employeeId": { "type": "string", "maxLength": 40 },
        "department": { "type": "string", "maxLength": 80 },
        "managerEmail": { "type": "string", "maxLength": 120 },
        "homeStoreName": { "type": "string", "maxLength": 120 },
        "homeStoreAddress": { "type": "string", "maxLength": 240 },
        "homeStorePlaceId": { "type": "string", "maxLength": 160 },
        "vehicleInfo": { "type": "string", "maxLength": 100 },
        "ratePerMile": { "type": "number" },
        "normalCommuteMiles": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "employeeName",
        "employeeId",
        "department",
        "managerEmail",
        "homeStoreName",
        "homeStoreAddress",
        "homeStorePlaceId",
        "vehicleInfo",
        "ratePerMile",
        "normalCommuteMiles",
        "createdAt",
        "updatedAt"
      ]
    },
    "MileageTrip": {
      "title": "MileageTrip",
      "description": "An individual business driving trip logged by a Curacao employee.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tripDate": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "originName": { "type": "string", "maxLength": 120 },
        "originAddress": { "type": "string", "maxLength": 240 },
        "originPlaceId": { "type": "string", "maxLength": 160 },
        "destinationName": { "type": "string", "maxLength": 120 },
        "destinationAddress": { "type": "string", "maxLength": 240 },
        "destinationPlaceId": { "type": "string", "maxLength": 160 },
        "purpose": {
          "type": "string",
          "enum": [
            "Inter-Store Transfer",
            "Shift Coverage",
            "Bank Deposit",
            "Supply Run",
            "Customer Delivery",
            "Training / HQ",
            "Other"
          ]
        },
        "notes": { "type": "string", "maxLength": 300 },
        "oneWayMiles": { "type": "number" },
        "commuteDeductionMiles": { "type": "number" },
        "billableMiles": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "isRoundTrip": { "type": "boolean" },
        "captureMethod": {
          "type": "string",
          "enum": ["route_auto", "gps_live", "template", "manual"]
        },
        "ratePerMile": { "type": "number" },
        "reimbursementAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["ready", "submitted"] },
        "reportId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "tripDate",
        "originName",
        "originAddress",
        "originPlaceId",
        "destinationName",
        "destinationAddress",
        "destinationPlaceId",
        "purpose",
        "notes",
        "oneWayMiles",
        "commuteDeductionMiles",
        "billableMiles",
        "durationMinutes",
        "isRoundTrip",
        "captureMethod",
        "ratePerMile",
        "reimbursementAmount",
        "status",
        "reportId",
        "createdAt",
        "updatedAt"
      ]
    },
    "RouteTemplate": {
      "title": "RouteTemplate",
      "description": "A saved recurring store-to-store or errand route for one-click trip logging.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "maxLength": 100 },
        "originName": { "type": "string", "maxLength": 120 },
        "originAddress": { "type": "string", "maxLength": 240 },
        "originPlaceId": { "type": "string", "maxLength": 160 },
        "destinationName": { "type": "string", "maxLength": 120 },
        "destinationAddress": { "type": "string", "maxLength": 240 },
        "destinationPlaceId": { "type": "string", "maxLength": 160 },
        "purpose": {
          "type": "string",
          "enum": [
            "Inter-Store Transfer",
            "Shift Coverage",
            "Bank Deposit",
            "Supply Run",
            "Customer Delivery",
            "Training / HQ",
            "Other"
          ]
        },
        "oneWayMiles": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "isRoundTrip": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "label",
        "originName",
        "originAddress",
        "originPlaceId",
        "destinationName",
        "destinationAddress",
        "destinationPlaceId",
        "purpose",
        "oneWayMiles",
        "durationMinutes",
        "isRoundTrip",
        "createdAt"
      ]
    },
    "MileageReport": {
      "title": "MileageReport",
      "description": "A finalized mileage reimbursement report grouping one or more submitted trips.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reportNumber": { "type": "string", "maxLength": 40 },
        "periodStart": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "periodEnd": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "employeeName": { "type": "string", "maxLength": 100 },
        "employeeId": { "type": "string", "maxLength": 40 },
        "department": { "type": "string", "maxLength": 80 },
        "homeStoreName": { "type": "string", "maxLength": 120 },
        "vehicleInfo": { "type": "string", "maxLength": 100 },
        "tripCount": { "type": "number" },
        "totalMiles": { "type": "number" },
        "totalReimbursement": { "type": "number" },
        "status": { "type": "string", "enum": ["submitted", "reimbursed"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "reportNumber",
        "periodStart",
        "periodEnd",
        "employeeName",
        "employeeId",
        "department",
        "homeStoreName",
        "vehicleInfo",
        "tripCount",
        "totalMiles",
        "totalReimbursement",
        "status",
        "submittedAt",
        "updatedAt"
      ]
    },
    "TripExpense": {
      "title": "TripExpense",
      "description": "A non-mileage business expense (such as parking or tolls) associated with a business trip or workday.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tripId": { "type": "string", "maxLength": 128 },
        "reportId": { "type": "string", "maxLength": 128 },
        "expenseDate": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "category": {
          "type": "string",
          "enum": ["Parking", "Tolls", "Express Lane", "Fuel / Gas", "Supplies", "Other"]
        },
        "description": { "type": "string", "maxLength": 160 },
        "amount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["ready", "submitted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "tripId",
        "reportId",
        "expenseDate",
        "category",
        "description",
        "amount",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private employee profile and mileage settings restricted strictly to the owning user."
    },
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/MileageTrip" },
      "description": "Business driving trips owned by the authenticated employee."
    },
    "/templates/{templateId}": {
      "schema": { "$ref": "#/entities/RouteTemplate" },
      "description": "Saved recurring route templates owned by the authenticated employee."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/MileageReport" },
      "description": "Submitted mileage reimbursement reports owned by the authenticated employee."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/TripExpense" },
      "description": "Non-mileage business expenses (parking, tolls, etc.) owned by the authenticated employee."
    }
  }
}
